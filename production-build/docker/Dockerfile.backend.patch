COPY backend/services/buddyIngest.js /app/services/buddyIngest.js
COPY backend/services/buddyExport.js /app/services/buddyExport.js
COPY backend/services/buddyContent.js /app/services/buddyContent.js
COPY backend/migrations/007_buddy_full_parity.sql /app/migrations/007_buddy_full_parity.sql
COPY backend/services/agentDashboardMetrics.js /app/services/agentDashboardMetrics.js
COPY backend/services/toneNormalize.js /app/services/toneNormalize.js
COPY backend/services/gpuMetrics.js /app/services/gpuMetrics.js
COPY backend/services/hostMemory.js /app/services/hostMemory.js
COPY backend/services/callProcessingLog.js /app/services/callProcessingLog.js
COPY backend/pythonScriptHandler.js /app/pythonScriptHandler.js
COPY backend/services/autoUploadService.js /app/services/autoUploadService.js
COPY backend/config/secrets.js /app/config/secrets.js
COPY backend/config/installSecrets.js /app/config/installSecrets.js
COPY backend/services/timeGuard.js /app/services/timeGuard.js
COPY backend/services/aiEntitlement.js /app/services/aiEntitlement.js
COPY backend/services/seatCounter.js /app/services/seatCounter.js
COPY backend/services/aiWorkToken.js /app/services/aiWorkToken.js
COPY backend/services/aiJobSlots.js /app/services/aiJobSlots.js
# Sprint 4 — license tamper-resistance modules + offline/vendor tools
COPY backend/services/licenseCodec.js /app/services/licenseCodec.js
COPY backend/services/licenseSecurity.js /app/services/licenseSecurity.js
COPY backend/services/licenseAudit.js /app/services/licenseAudit.js
# Sprint 5 — asymmetric (Ed25519) v3 licenses + runtime server fingerprint
COPY backend/services/licenseV3.js /app/services/licenseV3.js
COPY backend/services/hardwareId.js /app/services/hardwareId.js
# Sprint 7 — multi-point key fingerprint + verify loader (native/bytenode hooks)
COPY backend/services/licenseKeyGuard.js /app/services/licenseKeyGuard.js
COPY backend/services/licenseVerifyLoader.js /app/services/licenseVerifyLoader.js
# Vendor Ed25519 PUBLIC key — baked in (verify-only; cannot forge). Integrity-locked.
COPY backend/keys/vendor-root-public.pem /app/keys/vendor-root-public.pem
ENV LICENSE_PUBLIC_KEY_PATH=/app/keys/vendor-root-public.pem
COPY backend/tools/ /app/tools/
COPY production-build/docker/license-entrypoint.sh /app/license-entrypoint.sh
RUN chmod +x /app/license-entrypoint.sh /app/tools/*.js 2>/dev/null || true
# Sprint 7.4: bake ≥3 fingerprint anchors, then integrity-manifest (includes anchors).
# Strip any accidental source maps from the image (Sprint 7.5).
RUN node /app/tools/bake-key-fingerprints.js /app \
  && node /app/tools/build-integrity-manifest.js /app /app/integrity-manifest.json \
  && node -e "const fs=require('fs');const m=JSON.parse(fs.readFileSync('/app/integrity-manifest.json','utf8'));if(!Object.keys(m).length)process.exit(1)" \
  && find /app -type f -name '*.map' -delete 2>/dev/null || true
