COPY backend/agentController.js /app/agentController.js
COPY backend/agentHelper.js /app/agentHelper.js
COPY backend/testConnection.js /app/testConnection.js
COPY backend/routes/bankSettingsRoutes.js /app/routes/bankSettingsRoutes.js
COPY backend/routes/queryCategoryRoutes.js /app/routes/queryCategoryRoutes.js
COPY backend/routes/centerConfigPackRoutes.js /app/routes/centerConfigPackRoutes.js
COPY backend/routes/rubricRoutes.js /app/routes/rubricRoutes.js
