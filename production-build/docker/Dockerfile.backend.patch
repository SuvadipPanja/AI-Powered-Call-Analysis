# Backend hotfix — Sprint 3: reports split, upload queue, WS hub.
#                 Sprint 4: RSA-signed licenses, fingerprint, grace, audit, integrity.
# Build from project root:
#   docker build -t ai-call-backend:prod -f production-build/docker/Dockerfile.backend.patch .

FROM ai-call-backend:prod
COPY backend/package.json /app/package.json
RUN node -e "for (const p of ['bull','pdf-parse','xlsx','exceljs','mammoth','tesseract.js','pdfjs-dist','@napi-rs/canvas']) require.resolve(p)" \
  || npm install bull@4.16.5 pdf-parse@1.1.1 xlsx@0.18.5 exceljs@4.4.0 mammoth@1.9.0 tesseract.js@5.1.1 pdfjs-dist@4.8.69 @napi-rs/canvas@0.1.65 --omit=dev --no-audit --no-fund
COPY backend/server.js /app/server.js
COPY backend/sessionPolicy.js /app/sessionPolicy.js
COPY backend/uploadHandler.js /app/uploadHandler.js
COPY backend/middleware/auth.js /app/middleware/auth.js
COPY backend/middleware/rbac.js /app/middleware/rbac.js
COPY backend/middleware/sessionProof.js /app/middleware/sessionProof.js
COPY backend/middleware/logSafety.js /app/middleware/logSafety.js
COPY backend/middleware/rateLimit.js /app/middleware/rateLimit.js
COPY backend/middleware/reportScope.js /app/middleware/reportScope.js
COPY backend/middleware/reportCache.js /app/middleware/reportCache.js
COPY backend/middleware/licenseGuard.js /app/middleware/licenseGuard.js
COPY backend/routes/sessionRoutes.js /app/routes/sessionRoutes.js
COPY backend/routes/reportRoutes.js /app/routes/reportRoutes.js
COPY backend/routes/reportRoutes.register.js /app/routes/reportRoutes.register.js
