# Secrets / environment
.env
.env.*
!.env.example
!.env.production.template
*.pem
*.key

# Dependencies
node_modules/
**/node_modules/
ai-mvp/.venv-wsl/
**/.venv/
**/venv/
__pycache__/
*.pyc

# Build output
frontend/build/
frontend/coverage/
frontend/verify-screenshots/
dist/

# Regenerated by Dockerfile.frontend-base (see its header) — do not commit
production-build/docker/frontend-fs.tar

# Logs
logs/
**/logs/
*.log

# DB backups / generated SQL exports
scripts/sql/exported/
scripts/db/reports/
*.bak
backup/
backup.bak.*
call_analysis_db_*.bak

# Docker images (rebuild locally; do not version large tars)
production/docker-images/*.tar
production/images/*.tar
production/model-bundles/*.tar
production/model-bundles/*.tar.gz
production/model-bundles/faster-whisper-large-v3/

# License files (machine-bound — generate per server, never commit)
*.lic
**/license/*.lic
!**/license/.gitkeep
!**/license/README.md

# Vendor signing keys (private key must NEVER be committed)
vendor-keys/
**/vendor-root-private.pem

# Offline license generator source is versioned; generated material is not.
license-generator/node_modules/
license-generator/generated/
license-generator/.license-generator.lock
license-generator/*.lic
license-generator/*.pem
license-generator/local-config.json
license-generator/audit.log

# Sprint 4 — license signing keys & generated artifacts (never commit private keys)
license-keys/
**/license-private.pem
backend/integrity-manifest.json

# Sprint 6 — per-install secrets volume (generated at first boot; never commit)
**/install-secrets/

# Pre-filled deploy secrets (use *.example in repo)
deploy/ready/**/backend.env
deploy/ready/**/frontend.env*

# Local / editor / tooling
.cursor/
.claude/
.DS_Store
Thumbs.db
*.swp

# Local backups & scratch
code backup/
_extracted/
_pdfbuild/

# Runtime data (not source)
data/

# Optional: local ML model weights (keep source in ai-mvp/)
models/
production-build/model-cache/

# Large Python wheels (download in CI/prod build)
production-build/sp-nemo/wheels/*.whl
