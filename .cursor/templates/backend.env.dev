# Backend environment — LOCAL CLOUD DEV template.
# Copied to backend/.env by .cursor/install.sh when that file is missing.
# NOT for production. The DB password matches the local MSSQL dev container
# started by .cursor/start.sh (same value already used in docker-compose.dev.yml).

# === Project Base Directory ===
PROJECT_ROOT=/workspace
Project log=/workspace

# === Server Configuration ===
PORT=5000
WS_PORT=8080

# === Database Configuration (local MSSQL in Docker, SQL auth) ===
DB_USER=sa
DB_PASSWORD=Root@1234
DB_SERVER=127.0.0.1
DB_USE_WINDOWS_AUTH=false
DB_PORT=1433
DB_DATABASE=call_analysis_db
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# === Directory Paths ===
BACKEND_LOG_DIR=/workspace/logs/Backend Log
DETAILS_LOG_DIR=/workspace/logs/Details_Log
ACTION_LOG_DIR=logs
LICENSE_LOG_DIR=/workspace/logs/License_Log

PYTHON_SCRIPT_LOG_FILE=python_script.log
UPLOAD_HANDLER_LOG_FILE=upload_handler.log
ACTION_LOG_FILE=action.log
LICENSE_LOG_FILE=license.log

AUDIO_UPLOAD_DIR=/workspace/data/Sample_Audio
CHAT_DUMP_DIR=/workspace/data/Chat_Dump
PROFILE_PICS_DIR=assets/profile_pictures

# === AI Model Path (AI service out of scope for cloud dev) ===
MODEL_PATH=/models/DeepSeek-R1-Distill-Qwen-1.5B

# === Security Settings ===
CORS_ORIGIN=http://localhost:3000
API_AUTH_ENFORCE=true
SERVICE_TOKEN=
ORCHESTRATOR_SECRET=dev-orchestrator-secret-not-for-production
CALLBACK_SECRET=dev-callback-secret-not-for-production

# === License (local dev, MAC-locked to HOST_MAC below) ===
LICENSE_SECRET_KEY=dev-local-license-secret-key-32byte
LICENSE_FILE_PATH=./license/license.lic
HOST_MAC=02:42:AC:11:00:02
LICENSE_ENFORCE_SIGNATURE=false
LICENSE_GRACE_DAYS=7
LICENSE_INTEGRITY_CHECK=false
LICENSE_INTEGRITY_ENFORCE=false
LICENSE_GATE_ENABLE=false
LICENSE_GATE_DISABLE=false

# === AI MVP orchestrator / Redis ===
AI_MAIN_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
