# Frontend environment — LOCAL CLOUD DEV template.
# Copied to frontend/.env by .cursor/install.sh when that file is missing.
# CRA reads REACT_APP_* at dev-server start / build time.
#
# Without REACT_APP_API_BASE_URL the app falls back to window.location.origin
# (http://localhost:3000, the dev server) instead of the backend API. The
# WebSocket hub is served on the same port as the backend HTTP server (5000).
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_WS_URL=ws://localhost:5000
REACT_APP_ENV=development
