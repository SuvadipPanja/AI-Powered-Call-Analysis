# =============================================================================
#  HYBRID: Cloud LLM + local ASR (reduces GPU ~13 GB — removes sp_ai_llama VRAM)
#
#  Requires outbound HTTPS from sp_ai_controller to the API provider.
#  Banking / air-gap policy: get security approval before prod use.
#
#  Setup:
#    1) Copy to production/.env (merge with your secrets)
#    2) Get API key from Groq / Azure / Together (OpenAI-compatible)
#    3) Stop local vLLM — frees the most GPU:
#         docker compose stop llm
#    4) Recreate controller with cloud URL:
#         docker compose up -d --force-recreate ai-controller
#
#  NOTE: compose still defines llm service; keep it stopped. Controller no
#  longer needs llm healthy if llm container is stopped — start controller
#  after: docker compose up -d ai-controller --no-deps
# =============================================================================

# ---- Cloud LLM (Groq Qwen3-32B — better than local 14B, zero local VRAM) ---
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=REPLACE_WITH_GROQ_API_KEY
OPENAI_MODEL=qwen/qwen3-32b
OPENAI_DISABLE_THINKING=true
OPENAI_MAX_TOKENS=2048
LLM_BACKEND=openai

# Keep single-call economy (from env.shared-gpu.template)
AI_MAX_CONCURRENT_JOBS=1
UPLOAD_QUEUE_CONCURRENCY=1
ASR_CHUNK_PARALLELISM=1
AI_SERVICE_THREADS=1
WHISPER_LANG_DEVICE=cpu
GPU_DEVICE_ID=1

# Diarization: stereo only (no Pyannote)
DIAR_BACKEND=stereo
DIAR_PYANNOTE_ENABLED=false
DIARIZATION_REMOTE_ENABLED=false

# Reduce LLM calls on GPU-heavy phases (sentiment uses HF on CPU instead)
SENTIMENT_BACKEND=transformers
