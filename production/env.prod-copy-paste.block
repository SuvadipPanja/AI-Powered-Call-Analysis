# =============================================================================
#  MERGE INTO production/.env — hold + Silero GPU + GPU policy
#  No secrets. WinSCP: open prod .env, paste/merge these keys, save.
#
#  After save on prod:
#    cd /home/suvadip/Call-Analysis/Project/production
#    docker compose up -d --force-recreate ai-controller ai-whisper-lang ai-nemo ai-seamless
# =============================================================================

# ---- Hold detection + Silero VAD (GPU) -------------------------------------
HOLD_DETECTION_ENABLED=true
SILERO_VAD_DEVICE=cuda

# ---- ASR / LID device policy (GPU) -----------------------------------------
WHISPER_LANG_DEVICE=cuda
NEMO_DEVICE=cuda
SEAMLESS_M4T_DEVICE=cuda
FASTER_WHISPER_DEVICE=cuda

# ---- Enrichment on CPU (saves VRAM; vLLM scoring/intel still on GPU) --------
EMOTION2VEC_DEVICE=cpu
SENTIMENT_BACKEND=transformers

# ---- Transcript formatting -------------------------------------------------
TRANSCRIPT_FORMAT_NUMBERS_ENABLED=true

# ---- Single-call GPU economy (shared 48 GB GPU) -----------------------------
AI_MAX_CONCURRENT_JOBS=1
ASR_CHUNK_PARALLELISM=1
UPLOAD_QUEUE_CONCURRENCY=1
