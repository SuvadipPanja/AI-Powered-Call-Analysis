# =============================================================================
#  AI-Powered Call Analysis — PRODUCTION environment (single file, non-secret)
#  Copy to ".env" (prod path):
#    /home/suvadip/Call-Analysis/Project/production/.env
#  Secrets live ONLY under production/secrets/* — never put real values here.
#  Used for compose interpolation and bootstrap-prod-secrets.sh
#  (writes Docker secrets/* and auto-generated .env.container for backend env_file).
#
#  After copy on prod (keep existing secrets/* — bootstrap will not overwrite):
#    cd /home/suvadip/Call-Analysis/Project/production
#    bash scripts/bootstrap-prod-secrets.sh
#    bash scripts/validate-prod-layout.sh
#    docker compose up -d --force-recreate --no-deps backend
#
#  Distributed AI stack (2026-07-02): docs/AI-STACK-SPEC.md + docs/AI-STACK-RUNBOOK.md
#  Uncommented keys = you normally set/tune these.
#  Commented keys   = optional overrides; the value shown IS the compose default.
#  Env is read ONCE at container start — after edits run:
#    docker compose up -d <service>        (recreates only changed services)
# =============================================================================

# ---- Public address of THIS server (IP or domain, no http://) --------------
# The browser uses this to reach the backend. If it changes, rebuild the
# frontend image (scripts/00-build-and-save-images.sh).
PUBLIC_HOST=10.64.194.130

# ---- Database (SQL Server) -------------------------------------------------
# SA password lives in secrets/db_password (NOT required here).
# Bootstrap generates a strong password if the file is missing.
# docker compose up -d reads that file via Docker secrets — no SA_PASSWORD export.
# SA_PASSWORD=
# DB_PASSWORD=

# Controller/backend DB wiring (internal Docker DNS names)
DB_SERVER=db
DB_PORT=1433
DB_USER=sa
DB_DATABASE=call_analysis_db
DB_USE_WINDOWS_AUTH=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENABLED=true

# =============================================================================
#  ORG-LEVEL MULTI-TENANCY  (Master DB + database-per-org)  — default OFF
#  Full guide: Project Docomentation/MULTI_TENANCY_RUNBOOK.md
#  Leave ORG_TENANCY_ENABLED=false to run exactly as single-tenant (default).
#  To turn ON: set the 4 lines below, then recreate the backend once. The
#  existing call_analysis_db becomes org #1 automatically (no data movement).
# =============================================================================
# ORG_TENANCY_ENABLED=true
# MASTER_DB_DATABASE=ca_master
# DEFAULT_ORG_KEY=default
# DEFAULT_ORG_NAME=UCO Bank
# ORG_DB_PREFIX=ca_
# Platform (master-tier) Super Admin — seeded once on first boot if it does not
# exist. Log in at Admin Settings → Organizations, then CHANGE this password.
# You may blank these two lines after the first successful boot.
# PLATFORM_ADMIN_USER=platform
# PLATFORM_ADMIN_PASSWORD=Change-Me-Strong-Passw0rd!
# PLATFORM_ADMIN_NAME=Platform Super Admin
#
# --- AI follows org switches (Phase 4, GATED) — keep OFF until regressed ------
# Enable ONLY after a one-sample AI regression + rebuilding sp-ai-controller.
# With AI_DYNAMIC_DB=false the AI always writes to DB_DATABASE (safe default).
# AI_DYNAMIC_DB=true
# ACTIVE_DB_URL=http://backend:5000/api/internal/active-db
# AI_ACTIVE_DB_TTL_SEC=30

# ---- License (MAC-locked legacy / fingerprint for v3) ----------------------
# Legacy AES licenses: HOST_MAC must match the issued license.
# v3 Ed25519: fingerprint binding — HOST_MAC optional.
# Place license at production/license/license.lic
HOST_MAC=8c:84:74:6b:08:7e

# ---- App secrets (FILE-BACKED — do NOT put real values here) ---------------
# Source of truth: production/secrets/<name> → Docker /run/secrets/<name>
# Run:  bash scripts/bootstrap-prod-secrets.sh
#   - keeps existing secret files (never overwrites — preserves live licenses)
#   - migrates non-weak inline .env values once into secrets/*
#   - otherwise generates crypto-strong values into secrets/* only
#   - writes .env.container with secret keys stripped
# Leave these empty (or omit). Backend hydrateSecrets() loads files before assert.
# LICENSE_SECRET_KEY=
# ORCHESTRATOR_SECRET=
# CALLBACK_SECRET=
# SERVICE_TOKEN=
# JWT_SECRET=
# SESSION_SECRET=

# ---- License hardening (Sprint 4–9) ----------------------------------------
# Baked into sp-backend:prod image; do not leave LICENSE_PUBLIC_KEY_PATH empty.
LICENSE_PUBLIC_KEY_PATH=/app/keys/vendor-root-public.pem
# Sprint 6/Phase C: set true ONLY after a verified v3 license is installed on THIS host.
# Default false keeps legacy AES/MAC licenses working. Do NOT flip REQUIRE_V3 first.
LICENSE_REQUIRE_V3=false
# Prod fails closed on weak/missing secrets (override only for lab: ALLOW_WEAK_SECRETS=true)
# ENFORCE_SECRET_STRENGTH=true
# ALLOW_WEAK_SECRETS=false
LICENSE_ENFORCE_SIGNATURE=false
LICENSE_GRACE_DAYS=7
LICENSE_GATE_ENABLE=false
LICENSE_INTEGRITY_CHECK=false
LICENSE_INTEGRITY_ENFORCE=false
# Sprint 7 — multi-point public-key fingerprint (soft by default; do not force enforce)
# LICENSE_KEY_FP_CHECK=true
LICENSE_KEY_FP_ENFORCE=false
# Sprint 8 — time-tamper guard (HMAC seals use INSTALL_HMAC_SECRET)
# LICENSE_TIME_GUARD=true
# LICENSE_TIME_SKEW_MINUTES=120
LICENSE_TIME_GUARD_ENFORCE=false
LICENSE_TIME_GUARD_INTERVAL_MIN=15
LICENSE_REVALIDATE_INTERVAL_MIN=30
# Per-install HMAC secret dir (compose default /app/install-secrets volume)
# INSTALL_SECRETS_DIR=/app/install-secrets
# AUTO_GENERATE_INSTALL_SECRETS=true

# --- Sprint 9 AI work tokens ---
# AI_WORK_TOKEN_ENFORCE=false
# AI_WORK_TOKEN_TTL_SEC=900

# ---- CORS (REQUIRED — backend exits if empty in NODE_ENV=production) -------
# Origin(s) the browser loads the app from. Must match exactly how users open
# the UI (frontend publishes on FRONTEND_HTTP_PORT, default 8081, NOT port 80).
# Comma-separate multiple origins if needed (no wildcards).
CORS_ORIGIN=http://10.64.194.130:8081

# ---- Host ports (change only on port clash with another stack) -------------
# BACKEND_HTTP_PORT=5000
# BACKEND_WS_PORT=8080
# FRONTEND_HTTP_PORT=8081

# ---- Docker isolation / GPU (dual-GPU host: GPU 0 = other team) ------------
COMPOSE_PROJECT_NAME=call-analysis-prod
DOCKER_NETWORK_NAME=call-analysis-prod-net
# Host GPU index (0-based). All AI services + vLLM share this one GPU.
GPU_DEVICE_ID=1

# ---- LLM (vLLM, service "llm", container sp_ai_llama, :8001) ---------------
# 48 GB GPU safe default: Qwen3-14B-AWQ @ util 0.42 (~20 GB). Spikes target <38 GB.
LLM_SERVED_NAME=Qwen3-14B-AWQ
LLM_MODEL_PATH=/models/Qwen3-14B-AWQ
LLM_MAX_MODEL_LEN=8192
LLM_QUANTIZATION=awq
# vLLM GPU budget (no Qwen ASR sidecar — give LLM more room for speed).
LLM_GPU_MEMORY_UTIL=0.42
OPENAI_API_KEY=local-prod
OPENAI_MAX_TOKENS=2048
# Sentiment + single-call caps — see env.gpu-asr-llm.template for full GPU policy
SENTIMENT_BACKEND=llm
AI_NEMO_PRELOAD_LANGUAGES=English
AI_NEMO_REQUIRED_LANGUAGES=English
ASR_CHUNK_PARALLELISM=1
AI_SERVICE_THREADS=2
AI_MAX_CONCURRENT_JOBS=1
UPLOAD_QUEUE_CONCURRENCY=1
#
# ---- Preset: Qwen3-8B (tighter shared GPU / if 14B OOM) ---------------------
# LLM_SERVED_NAME=Qwen3-8B-AWQ
# LLM_MODEL_PATH=/models/Qwen3-8B-AWQ
# LLM_MAX_MODEL_LEN=6144
# LLM_GPU_MEMORY_UTIL=0.30
# SENTIMENT_BACKEND=llm
# AI_NEMO_PRELOAD_LANGUAGES=English
#
# ---- Preset: rollback to Llama-3.1-8B (pre-2026-07 behavior) ---------------
# LLM_SERVED_NAME=Meta-Llama-3.1-8B-Instruct
# LLM_MODEL_PATH=/models/Meta-Llama-3.1-8B-Instruct-AWQ
# LLM_GPU_MEMORY_UTIL=0.35
# WHISPER_LANG_DEVICE=cuda

# =============================================================================
#  AI DISTRIBUTED ARCHITECTURE (docs/AI-STACK-SPEC.md)
#  controller sp_ai_controller:8000 → whisper-lang :8010 · nemo :8020 ·
#  seamless :8030 · llm :8001. Backend keeps AI_MAIN_URL=http://ai:8000
#  (controller has network alias "ai").
# =============================================================================
# Master switch: true = controller calls the model services over HTTP;
# false = controller loads all models locally (old monolith behavior).
AI_DISTRIBUTED=true
# Service URLs (internal Docker DNS — change only for external/off-host services)
# AI_LANG_SERVICE_URL=http://ai-whisper-lang:8010
# AI_NEMO_SERVICE_URL=http://ai-nemo:8020
# AI_SEAMLESS_SERVICE_URL=http://ai-seamless:8030
# Per-request timeouts (seconds) for the language / ASR service HTTP calls
# AI_LANG_SERVICE_TIMEOUT_SEC=180
# AI_ASR_SERVICE_TIMEOUT_SEC=300
# Chunks transcribed in parallel per audio (controller-side ThreadPoolExecutor)
# 1 = one chunk at a time (shared-GPU prod default)
ASR_CHUNK_PARALLELISM=1
# gunicorn threads per model service (1 worker = 1 model copy on GPU; threads queue)
# 1 = one ASR/LID HTTP request at a time per service
AI_SERVICE_THREADS=1
AI_DIAR_SERVICE_THREADS=1

# ---- Single-call GPU economy (shared GPU with another team's apps) -----------
# Hard cap: only one call in the AI pipeline at a time (no license re-sign needed).
# 0 = unlimited (use license maxConcurrentJobs only).
AI_MAX_CONCURRENT_JOBS=1
UPLOAD_QUEUE_CONCURRENCY=1

# =============================================================================
#  TRANSCRIPTION ROUTING (read once at ai-controller start)
# =============================================================================
# The controller picks an ASR engine per DETECTED language, priority order:
#   1. FASTER_WHISPER_ASR_LANGUAGES → faster-whisper large-v3 (controller-local)
#   2. NEMO_ASR_LANGUAGES           → nemo SERVICE :8020 (English parakeet)
#   3. everything else              → seamless SERVICE :8030 (Hindi + other Indic)
# Service failures fall back to controller-local models, then faster-whisper.
# Values = comma-separated language names exactly as detected (e.g. Hindi,English).
# Apply changes with:  docker compose up -d ai-controller
#
# ---- Current production defaults (recommended) -----------------------------
#   English → nemo · Hindi / Bengali / Tamil / ... → seamless
TRANSCRIBE_BACKEND=nemo
NEMO_ASR_LANGUAGES=English
FASTER_WHISPER_ASR_LANGUAGES=
SEAMLESS_M4T_ENABLED=true
# Qwen ASR removed from prod stack (kept empty — do not set).
QWEN_ASR_LANGUAGES=
# GPU_METRICS_URL=http://gpu-metrics:9101/gpus
#
# ---- Preset: Hindi on NeMo conformer (nemo service, no extra container) ----
# NEMO_ASR_LANGUAGES=Hindi,English
# FASTER_WHISPER_ASR_LANGUAGES=
# SEAMLESS_M4T_ENABLED=true
#
# ---- Preset: Hindi on faster-whisper (code-mixed bank calls) ---------------
# NEMO_ASR_LANGUAGES=English
# FASTER_WHISPER_ASR_LANGUAGES=Hindi
# SEAMLESS_M4T_ENABLED=true
#
# Legacy external Sherpa-ONNX Hindi service (superseded by the nemo service;
# keep off unless the old sp-nemo container is deployed — do NOT add Bengali)
SP_NEMO_ENABLED=false
SP_NEMO_LANGUAGES=Hindi
# SP_NEMO_URL=http://sp-nemo:8020
#
# Retry once with relaxed settings when a chunk transcribes to empty text
# TRANSCRIPTION_RETRY_EMPTY=true
# Bengali: retry through the multilingual decoder when the Bengali pass is empty
# BENGALI_MULTILINGUAL_FALLBACK=true
# BENGALI_ASR_EXTRA_PADDING_SEC=0.5

# =============================================================================
#  MODELS (paths inside the containers — ./volumes/models is mounted /models)
# =============================================================================
# NeMo ASR (nemo service :8020; controller keeps them for local fallback)
# ENGLISH_NEMO_MODEL_PATH=/models/nemo/parakeet-rnnt-1.1b.nemo
# HINDI_NEMO_MODEL_PATH=/models/nemo/stt_hi_conformer_ctc_medium.nemo
NEMO_DEVICE=cuda
# NEMO_DECODER=rnnt
# NEMO_DUAL_DECODER=true
# NEMO_DUAL_DECODER_LANGUAGES=Bengali,Hindi,Assamese
# Which NeMo models load at startup / which must load for /health ready=true
# AI_NEMO_PRELOAD_LANGUAGES=English,Hindi
# AI_NEMO_REQUIRED_LANGUAGES=English
#
# SeamlessM4T v2 (seamless service :8030)
SEAMLESS_M4T_MODEL_PATH=/models/seamless-m4t-v2-large
SEAMLESS_M4T_DEVICE=cuda
#
# Whisper large-v3 language detection (whisper-lang service :8010)
WHISPER_LANG_MODEL_PATH=/models/Whisper-large-v3
# cuda = faster language detection (~2–3 GB VRAM on shared GPU).
WHISPER_LANG_DEVICE=cuda
#
# faster-whisper large-v3 (controller-local fallback ASR, lazy-loaded)
# FASTER_WHISPER_MODEL_PATH=/models/faster-whisper-large-v3
# FASTER_WHISPER_DOWNLOAD_ROOT=/models
FASTER_WHISPER_DEVICE=cuda
# FASTER_WHISPER_COMPUTE_TYPE=float16
# FASTER_WHISPER_VAD_FILTER=true
# FASTER_WHISPER_BEAM_SIZE=8

# =============================================================================
#  LANGUAGE DETECTION (whisper-lang service :8010; controller has the same
#  vars for its fallback path when the service is unreachable)
# =============================================================================
# Old AI/ pipeline layer: energy-ranked multi-window chunk voting
# AI_LANG_MULTI_CHUNK=true
# AI_LANG_CHUNK_COUNT=4
# AI_LANG_CHUNK_SEC=20
# LID strategy:
#   enhanced       = Whisper token + English guard + hi/bn disambiguation +
#                    script verification (default)
#   whisper-native = Whisper Large V3's built-in language detection ONLY,
#                    restricted to LANG_REGIONAL_LANGUAGES + multi-window vote.
#                    Try this if the enhanced guards misfire on your audio.
# LANG_DETECT_MODE=enhanced
# Regional mislabel guard (enhanced mode): reject Telugu/Tamil/... confirmation
# when forced-Hindi acoustically fits better by more than this margin.
# LANG_REGIONAL_ACOUSTIC_MARGIN=0.10
# Core detection thresholds
# LANG_DISAMBIGUATE_HI_BN=true
# LANG_DETECT_CONFIDENCE_MIN=0.55
# LANG_DETECT_HIGH_CONFIDENCE=0.82
# LANG_DETECT_SAMPLE_SEC=20
# LANG_VERIFY_SAMPLE_SEC=20
# LANG_LID_MAX_TRANSCRIPT_TOKENS=96
# Which stereo channel drives detection (customer = right channel by default)
# LANG_DETECT_CHANNEL=customer
# LANG_DETECT_AGENT_CHANNEL_INDEX=0
# LANG_DETECT_CUSTOMER_CHANNEL_INDEX=1
# LANG_DETECT_VOICE_TRIM=true
# hi/bn flip: only switch language when acoustic fit beats by this margin
# LANG_HI_BN_FLIP_MARGIN=0.06
# LANG_HI_BN_MIN_SCRIPT=6
# LANG_REPETITION_MIN_UNIQUE=0.5
# LANG_REPETITION_PENALTY=0.6
# LANG_SCRIPT_VERIFY=true
# LANG_VERIFY_ALWAYS=false
# LANG_VERIFY_ALWAYS_FOR_ENGLISH=true
# LANG_VERIFY_ALWAYS_FOR_DRAVIDIAN=true
# LANG_HINDI_PRIORITY_BONUS=8
# LANG_BENGALI_PRIORITY_BONUS=8
# LANG_ENGLISH_PLAUSIBILITY_MIN=0.35
# English guard: confirm real English before the hi/bn remap
# LANG_ENGLISH_GUARD_ENABLED=true
# LANG_ENGLISH_GUARD_MIN_PROB=0.12
# LANG_ENGLISH_GUARD_WORD_RATIO=0.40
# LANG_BENGALI_GUARD_ENABLED=true
# LANG_BENGALI_GUARD_MIN_PROB=0.12
# LANG_BENGALI_GUARD_MIN_ROMAN=1
# Call-center bias: prefer these languages on ambiguity
# LANG_CALL_CENTER_MODE=true
# LANG_PRIMARY_LANGUAGES=Hindi,Bengali,English
# Whisper mislabels Hindi as Urdu/Nepali — re-probe those as Hindi
# LANG_HINDI_CONFUSABLE_CODES=ur,ne
# LANG_MIN_SCRIPT_CHARS=12
# SEAMLESS_LID_ENABLED=false
# IndicLID (romanized/native Indic script classifier)
# INDICLID_ENABLED=true
# INDICLID_MODEL_DIR=/models/indiclid
# INDICLID_BERT_TOKENIZER_PATH=/models/indiclid/IndicBERTv2-MLM-only
# INDICLID_ROMAN_THRESHOLD=0.6
# INDICLID_MIN_SCORE=0.45

# =============================================================================
#  DIARIZATION + CHUNKING (ai-controller — stereo Silero VAD by default)
#  Pyannote container is in compose profile "pyannote" (not started on plain up).
#  Enable later: docker compose --profile pyannote up -d ai-diarization
# =============================================================================
DIAR_BACKEND=stereo
DIAR_PYANNOTE_ENABLED=false
DIARIZATION_REMOTE_ENABLED=false
# Silero VAD device: cuda (GPU-only prod default) | cpu | auto
SILERO_VAD_DEVICE=cuda
# Agent hold detection (phrase + silence gap on diarized transcript)
HOLD_DETECTION_ENABLED=true
# Anti-oversplit: drop short crosstalk blips / rejoin same-speaker turns
# DIAR_SUPPRESS_SANDWICHED_CROSSTALK=true
# DIAR_SANDWICH_MAX_DURATION_SEC=0.6
# DIAR_SANDWICH_RMS_RATIO=1.4
# DIAR_SAME_SPEAKER_MERGE_GAP_SEC=0.8
# Chunk preparation for ASR
# MIN_CHUNK_DURATION_SEC=0.8
# CHUNK_PADDING_SEC=0.3
# CHUNK_BOUNDARY_PAD_SEC=0.2
# ASR_INDIC_MIN_CHUNK_SEC=1.2

# =============================================================================
#  TRANSCRIPT CLEANUP / NORMALIZE (LLM post-correction before translation)
# =============================================================================
TRANSCRIPT_CLEANUP_ENABLED=true
TRANSCRIPT_CLEANUP_LANGUAGES=English,Hindi,Bengali,Tamil,Telugu,Marathi,Gujarati,Kannada,Malayalam,Punjabi,Odia,Assamese,Urdu
TRANSCRIPT_NORMALIZE_ENABLED=true
TRANSCRIPT_NORMALIZE_DROP_FILLER_TURNS=true
# Format spoken numbers/dates in transcript (e.g. "do hazaar" → "2000")
TRANSCRIPT_FORMAT_NUMBERS_ENABLED=true

# ---- Pipeline feature flags (ai-controller) ---------------------------------
# SCORING_ENABLED=true
# TRANSLATION_ENABLED=true
# ENRICHMENT_ENABLED=true
# CUSTOMER_ENHANCE_ENABLED=false

# =============================================================================
#  SENTIMENT / TONE / QUERY-TYPE ACCURACY (2026-07 upgrades, ai-controller)
# =============================================================================
# Sentiment: "llm" = per-utterance rating by the Qwen model (banking-aware,
# handles Hindi/Bengali/English code-switching); auto-falls back to the HF
# transformers pipelines on any LLM failure. "transformers" = CPU HF (shared-GPU default).
SENTIMENT_BACKEND=llm
# Utterances per LLM request (bounds prompt size on long calls)
# SENTIMENT_LLM_BATCH_SIZE=40
#
# Tone: "emotion2vec" = real speech-emotion model (angry/happy/neutral/sad/...)
# per diarized chunk, merged with the librosa pitch/energy levels the UI shows;
# falls back to librosa-only if the model dir is missing. "librosa" = old behavior.
# TONE_BACKEND=emotion2vec
# EMOTION2VEC_MODEL_PATH=/models/emotion2vec_plus_large
EMOTION2VEC_DEVICE=cuda
# HF sentiment on GPU when SENTIMENT_BACKEND=transformers (llm path uses vLLM already)
# SENTIMENT_DEVICE=cuda
#
# Query type: second LLM pass re-checks Primary_Query_Type against categories
# whose admin keywords appear in the transcript (balance vs mini-statement).
# INTELLIGENCE_VERIFY_ENABLED=true

# =============================================================================
#  QUERY CATEGORY AUTODISCOVERY (LLM → admin Query Types page)
# =============================================================================
QUERY_CATEGORY_AUTODISCOVER_ENABLED=true
QUERY_CATEGORY_AUTODISCOVER_MAX=60
QUERY_CATEGORY_DEDUPE_SIMILARITY=0.82

# =============================================================================
#  LOGGING (all AI services)
#  Rotating file logs land on the HOST at volumes/logs/<service>/<service>.log
#  (ai-controller / ai-whisper-lang / ai-nemo / ai-seamless / llm), rotated at
#  LOG_MAX_MB × LOG_BACKUP_COUNT. Docker json-file logs rotate at 50m × 5.
# =============================================================================
# LOG_LEVEL=INFO
# LOG_MAX_MB=20
# LOG_BACKUP_COUNT=10

# ---- Rate limiting (Sprint 2) -----------------------------------------------
# Global /api budget is counted PER LOGGED-IN USER (hashed session token).
# Cheap high-frequency polls are exempt. Raise only if a power user needs more.
# API_RATE_LIMIT_MAX=1000
# API_RATE_LIMIT_WINDOW_MS=60000
# WS log broadcast to browser (dev only; always off in NODE_ENV=production)
# WS_LOG_BROADCAST=false

# ---- Redis cache (Sprint 3) ---------------------------------------------------
# REDIS_URL is set below for Docker. Report GET responses cached for TTL seconds.
# REPORT_CACHE_TTL_SEC=60

# ---- Upload queue (Sprint 3 — Bull + Redis) -----------------------------------
UPLOAD_QUEUE_ENABLED=true
UPLOAD_QUEUE_CONCURRENCY=1
# UPLOAD_QUEUE_ATTEMPTS=3

# ---- WebSocket scaling (Sprint 3) ---------------------------------------------
# WS_REDIS_PUBSUB=true

# ---- Backend internal wiring (usually leave as-is) --------------------------
API_AUTH_ENFORCE=true
# Backend → controller (controller has network alias "ai")
AI_MAIN_URL=http://ai:8000
REDIS_URL=redis://redis:6379
# Controller → backend callbacks + entitlement polling
# BACKEND_INTERNAL_URL=http://backend:5000
# AI_ENTITLEMENT_POLL_SEC=90
# Controller container-internal paths (must match compose volume mounts)
# AUDIO_UPLOAD_DIR=/data/Sample_Audio
# LOG_DIR=/app/logs

# ---- Backend paths (required — docker-compose also sets these for the container) ----
PROJECT_ROOT=/app
BACKEND_LOG_DIR=/app/logs
DETAILS_LOG_DIR=/app/logs/details
PYTHON_SCRIPT_LOG_FILE=python_script.log
UPLOAD_HANDLER_LOG_FILE=upload_handler.log
CHAT_DUMP_DIR=/app/data/Chat_Dump
PROFILE_PICS_DIR=/app/assets/profile_pictures
BRANDING_DIR=/app/uploads/branding
ACTION_LOG_DIR=/app/logs
ACTION_LOG_FILE=action.log
CALL_PROCESSING_LOG_FILE=call_processing.log
