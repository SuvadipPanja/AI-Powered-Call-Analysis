# =============================================================================
#  GPU policy — ASR / LID / LLM on GPU; sentiment HF + emotion2vec on CPU
#  Reference only: merge desired keys into production/.env (do not commit secrets).
#  Runbook: production/docs/AI-STACK-RUNBOOK.md
# =============================================================================

# Host GPU index (0-based). All AI inference + vLLM share this GPU unless split-host.
GPU_DEVICE_ID=1

# ---- Language ID (Whisper-large-v3 service :8010) — GPU --------------------
WHISPER_LANG_DEVICE=cuda

# ---- ASR services — GPU -----------------------------------------------------
NEMO_DEVICE=cuda
SEAMLESS_M4T_DEVICE=cuda
FASTER_WHISPER_DEVICE=cuda

# ---- Diarization (controller-local stereo Silero; optional ai-diarization) --
SILERO_VAD_DEVICE=cuda
PYANNOTE_DEVICE=cuda

# ---- LLM (vLLM :8001) — GPU; cap util to leave headroom for ASR/LID --------
LLM_GPU_MEMORY_UTIL=0.42
OPENAI_DISABLE_THINKING=true

# ---- Enrichment — CPU (saves VRAM; LLM scoring/intel still on GPU via vLLM) -
SENTIMENT_BACKEND=transformers
EMOTION2VEC_DEVICE=cpu

# ---- Concurrency caps (shared 48 GB GPU safe defaults) ----------------------
AI_MAX_CONCURRENT_JOBS=1
ASR_CHUNK_PARALLELISM=1
AI_SERVICE_THREADS=2
AI_NEMO_SERVICE_THREADS=2
AI_SEAMLESS_SERVICE_THREADS=2

# ---- Optional: tighten if nvidia-smi spikes >42 GB during live calls --------
# LLM_GPU_MEMORY_UTIL=0.38
# WHISPER_LANG_DEVICE=cpu
# SENTIMENT_BACKEND=llm