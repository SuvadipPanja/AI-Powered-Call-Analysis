# =============================================================================
#  Language detection — CLEAN prod .env block (2026-07-03)
#  Replace ALL duplicate LANG_* / LLM_* / WHISPER_* lines in prod .env with this.
#  Remove: LANG_DETECT_MODE=whisper-native (disables all guards — causes mislabels)
# =============================================================================

# ---- LLM (Qwen3-14B — needs model bundle on prod) ----
LLM_SERVED_NAME=Qwen3-14B-AWQ
LLM_MODEL_PATH=/models/Qwen3-14B-AWQ
LLM_MAX_MODEL_LEN=8192
LLM_GPU_MEMORY_UTIL=0.55
LLM_QUANTIZATION=awq
OPENAI_MAX_TOKENS=2048
OPENAI_API_KEY=local-prod

# ---- Language detection (enhanced mode — NOT whisper-native) ----
LANG_DETECT_MODE=enhanced
LANG_DETECT_CHANNEL=agent
LANG_DETECT_MULTI_CHANNEL=true
LANG_LID_BACKEND=ensemble
SEAMLESS_LID_ENABLED=true
SEAMLESS_LID_PROBE_LANGUAGES=Hindi,Bengali,English
AI_SEAMLESS_SERVICE_URL=http://ai-seamless:8030
WHISPER_LANG_DEVICE=cuda
# cuda = ~3-5x faster LID on GPU 1. Use cpu only if VRAM is tight with Qwen.

AI_LANG_MULTI_CHUNK=true
AI_LANG_CHUNK_COUNT=3
AI_LANG_CHUNK_SEC=15

# Hindi/Bengali/English-only banking — blocks Telugu/Tamil mislabels on Hindi calls
LANG_PRIMARY_ONLY=true
LANG_REGIONAL_DETECTION=false
LANG_REGIONAL_LANGUAGES=Hindi,Bengali,English
LANG_PRIMARY_LANGUAGES=Hindi,Bengali,English
LANG_DRAVIDIAN_CONFUSABLE_CODES=ta,te,kn,ml
LANG_HINDI_CONFUSABLE_CODES=ur,ne

LANG_BENGALI_GUARD_ENABLED=true
LANG_BENGALI_GUARD_MIN_PROB=0.12
LANG_BENGALI_GUARD_MIN_ROMAN=1

LANG_HINDI_GUARD_ENABLED=true
LANG_HINDI_GUARD_MIN_PROB=0.10
LANG_FAST_PATH_HI_CONFIDENCE=0.78

LANG_ENGLISH_GUARD_ENABLED=true
LANG_ENGLISH_GUARD_MIN_PROB=0.12
LANG_ENGLISH_GUARD_WORD_RATIO=0.40

LANG_DISAMBIGUATE_HI_BN=true
LANG_BENGALI_PRIORITY_BONUS=8
LANG_HINDI_PRIORITY_BONUS=8
LANG_REGIONAL_ACOUSTIC_MARGIN=0.18

# ---- AI accuracy upgrades ----
SENTIMENT_BACKEND=llm
TONE_BACKEND=emotion2vec
EMOTION2VEC_MODEL_PATH=/models/emotion2vec_plus_large
EMOTION2VEC_DEVICE=cpu
INTELLIGENCE_VERIFY_ENABLED=true
